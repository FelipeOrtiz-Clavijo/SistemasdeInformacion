### Paso 2.5 - Celda 4: Lanzar Streamlit en segundo plano

    import subprocess, threading, time

    def run_streamlit():
        subprocess.run(["streamlit", "run", "app.py",
                        "--server.port", "8501",
                        "--server.headless", "true",
                        "--server.runOnSave", "true"])

    t = threading.Thread(target=run_streamlit)
    t.daemon = True
    t.start()
    time.sleep(5)
    print("Streamlit iniciado en puerto 8501")

